# Copy this file to .env and fill in your values.
# All keys are required unless marked optional.

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Pinecone ───────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=rag-prod
PINECONE_CLOUD=aws          # aws | gcp | azure
PINECONE_REGION=us-east-1

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/ragdb
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/ragdb
MONGODB_URI=mongodb://localhost:27017/ragdb

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Cloud:  rediss://user:pass@host:6380
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Models ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# ── Ingestion limits ──────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
MAX_FILES_PER_FOLDER=100
MAX_FOLDERS_PER_USER=20
