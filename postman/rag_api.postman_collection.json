{
  "info": {
    "name": "RAG API",
    "description": "Complete test collection for the RAG backend API.\n\n**Setup:**\n1. Import this collection.\n2. Set the `base_url` variable to `http://localhost:8000` (already set as default).\n3. Run **Auth / Register** once to create a user.\n4. Run **Auth / Login** — the `access_token`, `refresh_token`, and `user_id` collection variables are set automatically.\n5. All subsequent requests read the token from the collection variable — no manual copy-paste needed.\n6. Folder, file, and conversation IDs are also captured automatically as you work through the flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token",    "value": "",                      "type": "string" },
    { "key": "refresh_token",   "value": "",                      "type": "string" },
    { "key": "folder_id",       "value": "",                      "type": "string" },
    { "key": "file_id",         "value": "",                      "type": "string" },
    { "key": "conversation_id", "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deep Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/health/deep", "host": ["{{base_url}}"], "path": ["health", "deep"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has checks', () => pm.expect(body).to.have.property('checks'));",
                  "console.log('Service checks:', JSON.stringify(body.checks, null, 2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"testpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has id', () => pm.expect(body).to.have.property('_id'));",
                  "pm.test('has email', () => pm.expect(body.email).to.eql('test@example.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{base_url}}/auth/token", "host": ["{{base_url}}"], "path": ["auth", "token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "test@example.com" },
                { "key": "password", "value": "testpassword123" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has access_token', () => pm.expect(body).to.have.property('access_token'));",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "console.log('✓ Tokens saved to collection variables');"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "console.log('✓ Tokens refreshed and saved');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — wrong password (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{base_url}}/auth/token", "host": ["{{base_url}}"], "path": ["auth", "token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "test@example.com" },
                { "key": "password", "value": "wrongpassword" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Folders",
      "item": [
        {
          "name": "List Folders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/folders", "host": ["{{base_url}}"], "path": ["folders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "console.log('Folders:', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/folders", "host": ["{{base_url}}"], "path": ["folders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Knowledge Base\",\n  \"description\": \"Test folder for RAG evaluation\",\n  \"settings\": {\n    \"chunk_size\": 512,\n    \"chunk_overlap\": 50,\n    \"embedding_model\": \"text-embedding-3-small\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has _id', () => pm.expect(body).to.have.property('_id'));",
                  "pm.test('has pinecone_namespace', () => pm.expect(body).to.have.property('pinecone_namespace'));",
                  "pm.collectionVariables.set('folder_id', body._id);",
                  "console.log('✓ folder_id saved:', body._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Folder",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('correct id', () => pm.expect(body._id).to.eql(pm.collectionVariables.get('folder_id')));",
                  "pm.test('has stats', () => pm.expect(body).to.have.property('stats'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Knowledge Base (updated)\",\n  \"description\": \"Updated description\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => pm.expect(pm.response.json().name).to.include('updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Folder — not found (expect 404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/folders/000000000000000000000000", "host": ["{{base_url}}"], "path": ["folders", "000000000000000000000000"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Folder",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "console.log('⚠ Folder deleted — re-run Create Folder before testing files/conversations');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}/files", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}", "files"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "console.log('Files in folder:', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload File (form-data)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}/files", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}", "files"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Select one or more files to upload (.pdf, .md, .txt, .py, .json, .docx, .png, etc.)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('Returns array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('Status is pending', () => pm.expect(body[0].status).to.eql('pending'));",
                  "pm.collectionVariables.set('file_id', body[0]._id);",
                  "console.log('✓ file_id saved:', body[0]._id, '| status:', body[0].status);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get File (poll status)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/{{file_id}}", "host": ["{{base_url}}"], "path": ["files", "{{file_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has status field', () => pm.expect(body).to.have.property('status'));",
                  "console.log('File status:', body.status, '| chunks:', body.chunk_count, '| strategy:', body.parsing_strategy);",
                  "if (body.status === 'failed') {",
                  "  console.error('Ingestion failed:', body.error);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/files/{{file_id}}", "host": ["{{base_url}}"], "path": ["files", "{{file_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "console.log('File deleted');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get File — not found (expect 404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/files/000000000000000000000000", "host": ["{{base_url}}"], "path": ["files", "000000000000000000000000"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}/conversations", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}", "conversations"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "console.log('Conversations:', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/folders/{{folder_id}}/conversations", "host": ["{{base_url}}"], "path": ["folders", "{{folder_id}}", "conversations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test conversation\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has _id', () => pm.expect(body).to.have.property('_id'));",
                  "pm.collectionVariables.set('conversation_id', body._id);",
                  "console.log('✓ conversation_id saved:', body._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('correct id', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('conversation_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Messages (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/conversations/{{conversation_id}}/messages?page=1&page_size=50",
              "host": ["{{base_url}}"],
              "path": ["conversations", "{{conversation_id}}", "messages"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "page_size", "value": "50" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "console.log('Messages:', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "console.log('Conversation deleted — re-run Create Conversation before sending messages');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send Message (SSE stream)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "text/event-stream" }
            ],
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}/messages", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"What is this document about?\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('SSE content-type', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "const raw = pm.response.text();",
                  "pm.test('Has token events', () => pm.expect(raw).to.include('\"type\":\"token\"'));",
                  "pm.test('Has citations event', () => pm.expect(raw).to.include('\"type\":\"citations\"'));",
                  "pm.test('Has done event', () => pm.expect(raw).to.include('\"type\":\"done\"'));",
                  "",
                  "// Parse and log citations",
                  "const lines = raw.split('\\n').filter(l => l.startsWith('data:'));",
                  "lines.forEach(line => {",
                  "  try {",
                  "    const evt = JSON.parse(line.replace('data: ', ''));",
                  "    if (evt.type === 'citations') {",
                  "      console.log('Citations received:', evt.data.length);",
                  "      evt.data.forEach((c, i) => console.log(`  [${i+1}] ${c.file_name} score=${c.score.toFixed(2)}`));",
                  "    }",
                  "  } catch(_) {}",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Message — follow-up (multi-turn)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "text/event-stream" }
            ],
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}/messages", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Can you elaborate on the first point?\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has token events', () => pm.expect(pm.response.text()).to.include('\"type\":\"token\"'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Message — no auth (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}/messages", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}", "messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
